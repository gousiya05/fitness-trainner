# ────────────────────────────────────────────────
# AI Fitness Trainer — Environment Variables
# Copy this file to .env in each sub-project
# ────────────────────────────────────────────────

# ── Server (server/.env) ─────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/fitness_trainer
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/fitness_trainer

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=7d

# AI microservice URL
AI_SERVICE_URL=http://localhost:8000

# Frontend URL (for CORS — comma-separated if multiple)
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100


# ── Client (client/.env) ─────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_AI_URL=http://localhost:8000


# ── AI Service (ai-models/.env) ─────────────────
AI_HOST=0.0.0.0
AI_PORT=8000
MODEL_DIR=./models
